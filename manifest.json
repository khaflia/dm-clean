{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "48": "icons/icon-48.png"
      },
      "default_title": "Open Discrub"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content.js" ],
      "matches": [ "*://discord.com/*", "*://*.discord.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "Manage, search, and export your Discord messages with ease.",
   "host_permissions": [ "*://discord.com/*", "*://*.discord.com/*", "*://*.discordapp.com/*", "*://*.discordapp.net/*" ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "512": "icons/icon-512.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Discrub - Discord Message Manager",
   "permissions": [ "storage" ],
   "short_name": "Discrub",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.3",
   "web_accessible_resources": [ {
      "matches": [ "*://discord.com/*", "*://*.discord.com/*" ],
      "resources": [ "discrub.png", "bridge/*", "index.html", "assets/*", "*/*.zip", "launcher.html", "launcher.css", "launcher.js", "classic-wrapper.html", "classic-wrapper.css", "classic-wrapper.js", "classic/*" ]
   } ]
}
